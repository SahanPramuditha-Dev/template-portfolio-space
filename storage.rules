rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isBootstrapOwner() {
      return request.auth != null
        && request.auth.token.email == 'sahanpramuditha91@gmail.com';
    }

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && (
          exists(/databases/(default)/documents/admins/$(request.auth.token.email))
          || isBootstrapOwner()
        );
    }

    function isValidPublicUpload() {
      return request.resource != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches(
          'image/.*|video/mp4|video/webm|application/pdf'
        );
    }

    match /private/{allPaths=**} {
      allow read, write: if isAdmin();
    }

    match /{folder}/{allPaths=**} {
      allow read: if folder in ['public', 'uploads', 'site', 'projects', 'certificates', 'resources'];
      allow write: if isAdmin() && isValidPublicUpload();
    }

    match /{allPaths=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
