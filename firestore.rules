rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isBootstrapOwner() {
      return request.auth != null
        && request.auth.token.email == 'sahanpramuditha91@gmail.com';
    }

    function isAdmin() {
      return request.auth != null
        && (
          isBootstrapOwner()
          || exists(/databases/$(database)/documents/admins/$(request.auth.token.email))
        );
    }

    match /content/{docId} {
      // Only allow public read for the remaining non-migrated CMS configuration documents
      allow read: if docId in ['site', 'openSource', 'maintenancePlans'] || isAdmin();
      allow write: if isAdmin();
    }

    match /certifications/{itemId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }
    match /skills/{itemId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }
    match /experience/{itemId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }
    match /blog/{itemId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }
    match /testimonials/{itemId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }
    match /services/{itemId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }
    match /resources/{itemId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }
    match /faqs/{itemId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }

    match /site/public/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /publicStats/views {
      allow read, write: if true;
    }

    match /projects/{projectId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();

      match /versions/{versionId} {
        allow read, write: if isAdmin();
      }
    }

    match /blogPosts/{postId} {
      allow read: if resource.data.status == 'published';
      allow write: if isAdmin();
    }

    match /mediaAssets/{assetId} {
      allow read: if resource.data.visibility == 'public';
      allow write: if isAdmin();
    }

    match /inquiries/{inquiryId} {
      allow read, write: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /analyticsEvents/{eventId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isAdmin() || isBootstrapOwner();
    }

    match /galactic_leaderboard/{scoreId} {
      // Game leaderboard is completely public
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
