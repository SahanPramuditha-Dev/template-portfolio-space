rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isBootstrapOwner() {
      return request.auth != null
        && request.auth.token.email == 'sahanpramuditha91@gmail.com';
    }

    function isAdmin() {
      return request.auth != null
        && (
          isBootstrapOwner()
          || exists(/databases/$(database)/documents/admins/$(request.auth.token.email))
        );
    }

    match /content/{docId} {
      // Legacy public CMS documents. Keep public until the app is migrated to
      // the publish-safe collections below.
      allow read: if true;
      allow write: if isAdmin();
    }

    match /site/public/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /projects/{projectId} {
      allow read: if resource.data.status == 'published';
      allow write: if isAdmin();

      match /versions/{versionId} {
        allow read, write: if isAdmin();
      }
    }

    match /blogPosts/{postId} {
      allow read: if resource.data.status == 'published';
      allow write: if isAdmin();
    }

    match /mediaAssets/{assetId} {
      allow read: if resource.data.visibility == 'public';
      allow write: if isAdmin();
    }

    match /inquiries/{inquiryId} {
      allow read, write: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /analyticsEvents/{eventId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isAdmin() || isBootstrapOwner();
    }

    match /galactic_leaderboard/{scoreId} {
      // Game leaderboard is completely public
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
